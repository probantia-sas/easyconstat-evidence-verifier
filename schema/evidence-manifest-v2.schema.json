{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.easyconstat.com/spec/evidence-manifest-v2.schema.json",
  "title": "EasyConstat Evidence Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageType",
    "constatId",
    "createdAt",
    "capturedAt",
    "locale",
    "channel",
    "hashAlgorithm",
    "signatureProfile",
    "reportPath",
    "producer",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "packageType": { "const": "easyconstat-evidence" },
    "constatId": { "type": "string", "pattern": "^[A-Z0-9]{10,16}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "locale": { "enum": ["fr", "en"] },
    "channel": { "enum": ["automatic", "operator-central", "operator-external"] },
    "hashAlgorithm": { "const": "SHA-256" },
    "signatureProfile": { "const": "ASiC-E/CAdES-B-LT" },
    "reportPath": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,179}$" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legalName", "country", "siret"],
      "properties": {
        "legalName": { "const": "PROBANTIA SAS" },
        "country": { "const": "FR" },
        "siret": { "const": "94269495100016" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "mediaType", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,179}$" },
          "role": {
            "enum": [
              "report",
              "capture-image",
              "capture-rendering",
              "activity-log",
              "network-report",
              "source",
              "navigation-video",
              "target-document",
              "http-metadata",
              "other"
            ]
          },
          "mediaType": { "type": "string", "pattern": "^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$" },
          "size": { "type": "integer", "minimum": 0, "maximum": 4294967296 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
