<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 https://maven.apache.org/xsd/assembly-1.1.3.xsd">
    <id>runtime</id>
    <formats><format>zip</format></formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>${project.build.finalName}</baseDirectory>
    <files>
        <file>
            <source>${project.build.directory}/${project.build.finalName}-runtime-core.jar</source>
            <destName>verifier.jar</destName>
            <fileMode>0644</fileMode>
        </file>
        <file>
            <source>${project.basedir}/docs/THIRD_PARTY_INVENTORY.md</source>
            <destName>THIRD_PARTY_INVENTORY.md</destName>
            <fileMode>0644</fileMode>
        </file>
    </files>
    <fileSets>
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>LICENSE</include>
                <include>NOTICE</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/src/distribution</directory>
            <outputDirectory>/</outputDirectory>
            <includes><include>README.md</include></includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/src/distribution</directory>
            <outputDirectory>/licenses</outputDirectory>
            <includes><include>DSS-LICENSE.txt</include></includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.build.directory}/runtime-notices</directory>
            <outputDirectory>/licenses</outputDirectory>
            <fileMode>0644</fileMode>
        </fileSet>
    </fileSets>
    <dependencySets>
        <dependencySet>
            <outputDirectory>/lib</outputDirectory>
            <useProjectArtifact>false</useProjectArtifact>
            <scope>runtime</scope>
            <includes><include>*:*:jar</include></includes>
            <unpack>false</unpack>
            <fileMode>0644</fileMode>
        </dependencySet>
    </dependencySets>
</assembly>
